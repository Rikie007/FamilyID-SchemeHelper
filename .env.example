PORT=4000
HOST=0.0.0.0

# Atlas. Do not commit the real URI.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/GovernmentSchemeManagement
MONGO_DB_NAME=GovernmentSchemeManagement

# Set true only when you intend to wipe this database and re-load demo families/schemes.
SEED_RESET=false

# Comma-separated browser origins. Empty = allow all (prototype).
CORS_ORIGIN=
